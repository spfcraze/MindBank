#!/usr/bin/env bash
# mindbank-mcp-check — Check if MindBank MCP server is running
# Returns 0 if healthy, 1 if not running or unhealthy
# Usage: ./mindbank-mcp-check [port]
#
# v2: Validates PID matches actual mindbank-mcp process, not just any process.

PORT="${1:-8096}"
PIDFILE="/tmp/mindbank-mcp.pid"

# Check if PID file points to a real mindbank-mcp process
is_mcp_running() {
    local pid="$1"
    if ! kill -0 "$pid" 2>/dev/null; then
        return 1
    fi
    local cmdline
    cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
    if [[ "$cmdline" == *"mindbank-mcp"* ]]; then
        return 0
    fi
    return 1
}

# Check PID file
if [ -f "$PIDFILE" ]; then
    PID=$(cat "$PIDFILE" 2>/dev/null || true)
    if [ -n "$PID" ] && is_mcp_running "$PID"; then
        # PID is valid and points to mindbank-mcp, check health
        if curl -s --max-time 1 "http://localhost:$PORT/health" > /dev/null 2>&1; then
            echo "running"
            echo "PID=$PID"
            echo "Port=$PORT"
            exit 0
        fi
        # Process exists but not healthy — stale
        echo "stale"
        echo "PID=$PID (mindbank-mcp not responding on port $PORT)"
        exit 1
    fi
    # PID file exists but process is dead or reused by something else
    echo "stale"
    echo "PID=$PID (not mindbank-mcp)"
    exit 1
fi

# No PID file — check port directly
if curl -s --max-time 1 "http://localhost:$PORT/health" > /dev/null 2>&1; then
    echo "running (no PID file)"
    echo "Port=$PORT"
    exit 0
fi

echo "not_running"
exit 1
