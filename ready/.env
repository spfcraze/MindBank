# MindBank Configuration
# All real passwords removed. Set these before deploying.
# Copy to .env and fill in your values.

# Database password (set this!)
MB_POSTGRES_PASSWORD=CHANGEME

# Full database DSN
MB_DB_DSN=postgres://mindbank:CHANGEME@localhost:5434/mindbank?sslmode=disable

# Service ports
MB_PG_PORT=5434
MB_OLLAMA_PORT=11434
MB_PORT=8095

# MCP server port (Hermes integration)
MCP_HTTP_PORT=8096

# Logging
MB_LOG_LEVEL=info

# Embedding model
MB_EMBED_MODEL=nomic-embed-text

# Ollama URL
MB_OLLAMA_URL=http://localhost:11434
